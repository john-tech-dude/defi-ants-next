                      </svg>
                      <span className="text-muted-foreground">{item}</span>
                    </motion.li>
                  ))}
                </ul>
              </div>

              <div className="space-y-6">
                <h4 className="text-xl font-bold">Token Metrics</h4>
                <div className="grid grid-cols-2 gap-4">
                  {[
                    {
                      icon: <PieChartIcon className="h-6 w-6 text-primary-500 group-hover:text-primary-600 transition-colors" />,
