    secondary: `bg-transparent border-2 border-yellow-400 hover:bg-yellow-400 ${isDark ? 'text-yellow-400 hover:text-black' : 'text-yellow-600 hover:text-black'}`,
    danger: `bg-gradient-to-r from-red-600 to-red-700 border-2 border-red-400 text-white`
  };
  
  const sizes = {
    small: 'px-4 py-2 text-sm',
    medium: 'px-6 py-3 text-base',
    large: 'px-8 py-4 text-lg'
  };

  return (
    <motion.button
      whileHover={{ scale: 1.05, boxShadow: "0 0 25px rgba(255, 215, 0, 0.4)" }}
      whileTap={{ scale: 0.95 }}
      disabled={disabled}
